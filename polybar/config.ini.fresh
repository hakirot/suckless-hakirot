;==========================================================
;
;
;   ██████╗  ██████╗ ██╗  ██╗   ██╗██████╗  █████╗ ██████╗
;   ██╔══██╗██╔═══██╗██║  ╚██╗ ██╔╝██╔══██╗██╔══██╗██╔══██╗
;   ██████╔╝██║   ██║██║   ╚████╔╝ ██████╔╝███████║██████╔╝
;   ██╔═══╝ ██║   ██║██║    ╚██╔╝  ██╔══██╗██╔══██║██╔══██╗
;   ██║     ╚██████╔╝███████╗██║   ██████╔╝██║  ██║██║  ██║
;   ╚═╝      ╚═════╝ ╚══════╝╚═╝   ╚═════╝ ╚═╝  ╚═╝╚═╝  ╚═╝
;
;
;   To learn more about how to configure Polybar
;   go to https://github.com/polybar/polybar
;
;   The README contains a lot of information
;
;==========================================================

[colors]
; switched from color0
background = ${xrdb:*.background}
foreground = ${xrdb:*.foreground}
black = ${xrdb:*.color0}
black_bold = ${xrdb:*.color8}
cyan_bold = ${xrdb:*.color14}
red = ${xrdb:*.color1}
green = ${xrdb:*.color2}
yellow = ${xrdb:*.color3}
blue = ${xrdb:*.color4}
magenta = ${xrdb:*.color5}
cyan = ${xrdb:*.color6}
white = ${xrdb:*.color7}

[module/xkeyboard]
type = internal/xkeyboard
format = <label-indicator>
label-layout-background = ${colors.red}
label-layout-foreground = ${colors.red}
label-indicator-background = ${colors.red}
label-indicator-foreground = ${colors.red}
; label-indicator-on-capslock = 
;label-indicator-on-capslock = "   "
label-indicator-on-capslock = "   "

[module/menu-apps]
type =  custom/menu
expand-right = true

menu-0-0 = HDMI OFF
menu-0-0-exec = /home/roe/scrmp/polybar/hdmi_off
menu-0-1 = HDMI ON
menu-0-1-exec = /home/roe/scrmp/polybar/hdmi_on
label-open = "   "
label-close = "   "
label-separator = " | "

[module/tray]
type = internal/tray
format-margin = 8px
tray-spacing = 8px

[module/system-bluetooth-bluetoothctl]
type = custom/script
exec = ~/scrmp/polybar/bluetoothctl
tail = true
click-left = ~/polybar-scripts/system-bluetooth-bluetoothctl.sh --toggle &

[module/reskin]
type =  custom/script
exec = echo "hi"
interval = 1000000000
tail = true
click-left = ~/skps/reskin -r
format = <label>
label = "  "
format-background = ${colors.background}
format-foreground = ${colors.green}

[module/backlight]
type = internal/backlight
card = intel_backlight
poll-interval = 5
enable-scroll = true
scroll-interval = 5
format-prefix = " "
format-prefix-foreground = ${colors.cyan}

[module/battery]
type = internal/battery
full-at = 97
low-at = 10
battery = BAT0
adapter = AC0
poll-interval = 5
label-full = " "
label-low = " BATTERY LOW %percentage%%"
label-discharging = "  %percentage%%"
label-charging = " %percentage%%"

[module/dwm]
type = internal/dwm
format = <label-tags> <label-layout> <label-floating>
; Path to dwm socket (default: /tmp/dwm.sock)
; socket-path = /tmp/dwm.sock

; Left-click to view tag, right-click to toggle tag view
enable-tags-click = true
; Scroll to cycle between available tags
enable-tags-scroll = false
; If true and enable-tags-scroll = true, scrolling will view all tags regardless if occupied
tags-scroll-empty = false
; If true and enable-tags-scroll = true, scrolling will cycle through tags backwards
tags-scroll-reverse = false
; If true and enable-tags-scroll = true, wrap active tag when scrolling
tags-scroll-wrap = false
; Left-click to set secondary layout, right-click to switch to previous layout
enable-layout-click = false
; Scroll to cycle between available layouts
enable-layout-scroll = false
; Wrap when scrolling and reaching beginning/end of layouts
layout-scroll-wrap = false
; Reverse scroll direction
layout-scroll-reverse = false

; If enable-layout-click = true, clicking the layout symbol will switch to this layout
secondary-layout-symbol = [M]

; Separator in between shown tags
; label-separator = |

; Defaults to 'Desktop'
label-title-default = "Desktop"

; Symbol of current layout
; Available tokens:
;   %symbol%
label-layout = %symbol%
label-layout-padding = 1
label-layout-foreground = ${colors.white}
label-layout-background = ${colors.background}

; Text to show when currently focused window is floating
label-floating = F

; States: focused, unfocused, visible, urgent, empty
; Available tokens:
;   %name%

; focused = Selected tag on focused monitor
label-focused = %name%
label-focused-background = ${colors.black}
label-focused-foreground = ${colors.magenta}
; just edited
label-focused-underline= ${colors.green}
label-focused-padding = 2

; unfocused = Unselected tag on unselected monitor
label-unfocused = %name%
; no worky :[
label-unfocused-foreground = ${colors.white}
label-unfocused-padding = 2

; visible = Unselected tag, but occupied tag on any monitor
label-visible = %name%
; label-visible-background = ${self.label-focused-background}
label-visible-background = ${colors.background}
label-visible-foreground = ${colors.green}
label-visible-underline = ${self.label-focused-underline}
label-visible-padding = ${self.label-focused-padding}

; urgent = Unselected tag with window that has urgency hint set
label-urgent = %name%
label-urgent-background = ${colors.green}
label-urgent-padding = 2

; empty = Unselected and unoccupied tag
; This can be set to an empty string to hide empty tags
label-empty = %name%
label-empty-background = ${colors.background}
label-empty-foreground = ${colors.white}
label-empty-padding = 2

[module/pulseaudio]
type = internal/pulseaudio

format-volume-prefix = "  "
format-volume-prefix-foreground = ${colors.green}
format-volume-prefix-background = ${colors.background}
format-volume = <label-volume>

label-volume = "%percentage%%"
label-volume-background = ${colors.background}
label-muted = MUT 
label-muted-foreground = ${colors.green}
label-muted-background = ${colors.background}
interval = 1

[module/cpu]
type = internal/cpu
interval = 2
;format-prefix = " "
format-prefix = CPU
format-prefix-foreground = ${colors.green}
label = %percentage:2%%

[module/memory]
type = internal/memory
interval = 2
;format-prefix = " "
format-prefix = "MEM "
format-prefix-foreground = ${colors.green}
label = %percentage_used:2%%

[module/mpd]
format-online = <label-song> <toggle> <bar-progress> <label-time>
format-offline = <label-offline>
bar-progress-width = 12
bar-progress-indicator = █
icon-play = ▶
icon-pause = ■
bar-progress-fill = █
bar-progress-empty = ─
type = internal/mpd
host = 127.0.0.1
port = 6600
interval = 1
label-offline = 🤬
toggle-on-foreground = #f00
toggle-off-foreground = #f00
padding = 20
module-margin = 20

[module/network]
type = internal/network
interface = wlp3s0
interface-type = wireless
interal = 3.0

[module/network-deck]
type = internal/network
interface = wlp11s0
label-interface-foreground = ${colors.red}
interface-type = wireless
interal = 3.0
animation-packetloss-0 = ⚠

[network-base]
type = internal/network
interval = 2
format-connected = <label-connected>
format-disconnected = <label-disconnected>
label-disconnected = %{F#F0C674}%ifname%%{F#707880} disconnected
format-prefix = "NET "

[module/wlan]
inherit = network-base
interface-type = wireless
label-connected = %{F#F0C674}%ifname%%{F-} %essid% %local_ip%

[module/eth]
inherit = network-base
interface-type = wireless
interface = wlp3s0
label-connected =%{F#decfc5}%downspeed%

[module/eth-deck]
inherit = network-base
interface-type = wireless
interface = wlp11s0
label-connected =%{F#decfc5}%downspeed%

[module/date]
type = internal/date
interval = 1

date = %I:%M
date-alt = %d-%m-%Y %H:%M:%S

label = %date%
label-foreground = ${colors.cyan_bold}

[settings]
screenchange-reload = true
pseudo-transparency = false

; -------- Main CONFIG ----------
[bar/monitor-main]
monitor = MONITOR_DEFINE
border-size = 1px
border-color = ${colors.red}
width = 100%
; altmini
;height = 10pt
height = 24pt
radius = 0

dpi = 100

background = ${colors.background}
foreground = ${colors.foreground}

padding-left = 1px
padding-right = 1px
module-margin = 0

; altmini
font-0 = "JetBrains Mono:size=12;1"
font-1 = "Symbols Nerd Font Mono:size=12"

modules-left = dwm reskin menu-apps xkeyboard 
modules-center = date
modules-right = mpd pulseaudio

cursor-click = pointer
cursor-scroll = ns-resize

enable-ipc = true

override-redirect = false
pseudo-transparency = false
